# Copy this file somewhere protected, replace both credential placeholders,
# chmod it 0600, and pass it to every Compose command with `--env-file`.
#
# Generate the values without putting them in shell history:
#   openssl rand -base64 48
#   openssl rand -hex 32

# `latest` is convenient for a first run. Pin `vX.Y.Z` for reproducible service.
LIBRARIAN_VERSION=latest

LIBRARIAN_AGENT_TOKEN=replace-with-output-of-openssl-rand-base64-48
LIBRARIAN_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# Both published endpoints are loopback-only by default.
LIBRARIAN_DASHBOARD_PUBLISHED_HOST=127.0.0.1
LIBRARIAN_DASHBOARD_PORT=3042
LIBRARIAN_MCP_PUBLISHED_HOST=127.0.0.1
LIBRARIAN_MCP_PORT=3838

# The default named volume survives `docker compose down` (but not `down -v`).
# To use a host directory instead, set an absolute path and its owner IDs:
# LIBRARIAN_DATA_SOURCE=/srv/librarian
LIBRARIAN_DATA_SOURCE=librarian_data
LIBRARIAN_DATA_UID=1000
LIBRARIAN_DATA_GID=1000

# Optional deployment settings:
# LIBRARIAN_AGENT_TOKENS=codex:<token-a>,claude:<token-b>
# LIBRARIAN_BOOTSTRAP_CLAIM_SECRET=<at-least-32-characters>
# LIBRARIAN_ALLOWED_ORIGINS=https://memory.example.com
# LIBRARIAN_SINGLE_PORT=true
# LIBRARIAN_PUBLIC_URL=https://memory.example.com
# Operator DNS for the container (replaces Docker's default resolv.conf when
# set). Leave unset for the default. Needed when the curator's LLM provider is
# only reachable on a tailnet: put the Tailscale resolver FIRST (c-ares never
# consults a later nameserver after an NXDOMAIN; IP-based access fails because
# Tailscale Serve TLS needs the hostname SNI). MagicDNS forwards public
# lookups, so the single server usually suffices.
# LIBRARIAN_DNS=100.100.100.100
# LIBRARIAN_DNS_FALLBACK=8.8.8.8

