{
  "name": "the-librarian",
  "version": "1.21.0",
  "description": "A portable, agent-agnostic memory system for AI agents.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@>=3.0.0 <3.3.17": "3.3.17",
      "nanoid@>=5.0.0 <5.1.16": "5.1.16",
      "postcss@<=8.5.25": "8.5.26",
      "sharp@<0.35.0": "0.35.3",
      "svgo@>=4.0.0 <4.0.2": "4.0.2",
      "tar@<=7.5.21": "7.5.22",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "undici@>=8.0.0 <8.9.0": "8.9.0",
      "ws@>=8.0.0 <8.21.3": "8.21.3",
      "@babel/core@<7.29.7": "7.29.7",
      "protobufjs@<7.6.5": "7.6.5"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "start": "pnpm --filter @librarian/mcp-server start",
    "serve": "pnpm --filter @librarian/mcp-server serve",
    "dashboard": "pnpm --filter @librarian/mcp-server serve",
    "rebuild": "pnpm --filter @librarian/cli rebuild",
    "seed": "pnpm --filter @librarian/cli seed",
    "test": "pnpm -r run build && pnpm -r run test:vitest && vitest run",
    "smoke": "node --no-warnings scripts/smoke-test.js",
    "healthcheck": "node --no-warnings scripts/healthcheck.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "docs:gen": "node --no-warnings scripts/docs-gen.mjs",
    "docs:screenshots": "pnpm --filter @librarian/dashboard run screenshots",
    "sync:versions": "node scripts/stamp-version.mjs",
    "check:test-count": "node --no-warnings scripts/check-test-count.mjs",
    "check:no-secrets-in-vault": "node --no-warnings scripts/check-no-secrets-in-vault.mjs",
    "check:naming-canon": "node --no-warnings scripts/check-naming-canon.mjs",
    "check:release": "node --no-warnings scripts/check-release.mjs",
    "check:docs": "node --no-warnings scripts/check-docs.mjs",
    "audit:agent-ids": "node --no-warnings scripts/audit-agent-ids.mjs",
    "backfill:agent-ids": "node --no-warnings scripts/backfill-agent-ids.mjs",
    "measure:shelf-index-rss": "node --no-warnings --expose-gc scripts/measure-shelf-index-rss.mjs"
  },
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@librarian/cli": "workspace:*",
    "@librarian/core": "workspace:*",
    "@librarian/mcp-server": "workspace:*",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^57.0.0",
    "globals": "^15.15.0",
    "lefthook": "^1.13.6",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.66.0",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0"
}
